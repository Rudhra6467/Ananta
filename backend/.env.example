# ---- Ananta backend environment (copy values into your host's dashboard, do NOT commit real secrets) ----

# MongoDB connection (use a free MongoDB Atlas cluster: https://www.mongodb.com/atlas)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=ananta

# Comma-separated list of allowed frontend origins (your Vercel URL). Use * only for quick testing.
# Agent Ananta talks to this API directly; it does not need the frontend running.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth — set strong values. Agent Ananta uses OWNER_EMAIL / OWNER_PASSWORD via POST /api/auth/login.
JWT_SECRET=change-me-to-a-long-random-string
OWNER_EMAIL=owner@ananta.ai
OWNER_PASSWORD=change-me-strong-password

# Emergent universal LLM key (macro reasoning, gated behind Hunter triggers). Optional; leave blank.
# Hosted Emergent app hosting is expired and is not required for the local backend or Agent lab.
EMERGENT_LLM_KEY=

# FRED macro data (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Live trading is OFF by default (PAPER mode). Leave these as-is unless going live.
LIVE_TRADING_ENABLED=false
EXCHANGE_NAME=kraken
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
LIVE_MAX_SLIPPAGE_PCT=0.5
LIVE_FILL_TIMEOUT_SECONDS=30
LIVE_SPREAD_RECHECK_MS=500
